<?xml version="1.0"?>
<robot name="service_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.4 0.8 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="15.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.2625" ixy="0" ixz="0" iyy="0.2625" iyz="0" izz="0.46875"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.25" length="0.15"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.25" length="0.15"/></geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.26 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="left_wheel_link">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0041" ixy="0" ixz="0" iyy="0.0041" iyz="0" izz="0.0075"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.26 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="right_wheel_link">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0041" ixy="0" ixz="0" iyy="0.0041" iyz="0" izz="0.0075"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
    </collision>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.18 0 -0.10" rpy="0 0 0"/>
  </joint>
  <link name="front_caster_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
  </link>

  <joint name="back_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_caster_link"/>
    <origin xyz="-0.18 0 -0.10" rpy="0 0 0"/>
  </joint>
  <link name="back_caster_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
  </link>

  <joint name="torso_joint" type="fixed">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.475" rpy="0 0 0"/>
  </joint>
  <link name="torso_link">
    <inertial>
      <mass value="12.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.68" ixy="0" ixz="0" iyy="0.73" iyz="0" izz="0.13"/>
    </inertial>
    <visual>
      <geometry><box size="0.3 0.2 0.8"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.8"/></geometry>
    </collision>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.475" rpy="0 0 0"/>
  </joint>
  <link name="head_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><box size="0.15 0.15 0.15"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.15 0.15 0.15"/></geometry>
    </collision>
  </link>

  <xacro:macro name="arm_7dof" params="side reflect">

    <joint name="${side}_shoulder_pitch_joint" type="revolute">
      <parent link="torso_link"/>
      <child link="${side}_shoulder_pitch_link"/>
      <origin xyz="0 ${reflect * 0.16} 0.3" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159" upper="3.14159" effort="40.0" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <link name="${side}_shoulder_pitch_link">
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <geometry><sphere radius="0.01"/></geometry>
        <material name="orange"/>
      </visual>
    </link>

    <joint name="${side}_shoulder_roll_joint" type="revolute">
      <parent link="${side}_shoulder_pitch_link"/>
      <child link="${side}_shoulder_roll_link"/>
      <origin xyz="0 ${reflect * 0.02} 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="40.0" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <link name="${side}_shoulder_roll_link">
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <geometry><sphere radius="0.01"/></geometry>
        <material name="orange"/>
      </visual>
    </link>

    <joint name="${side}_shoulder_yaw_joint" type="revolute">
      <parent link="${side}_shoulder_roll_link"/>
      <child link="${side}_upper_arm_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708" upper="1.5708" effort="30.0" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <link name="${side}_upper_arm_link">
      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 -0.125" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.125" rpy="0 0 0"/>
        <geometry><cylinder radius="0.03" length="0.25"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.125" rpy="0 0 0"/>
        <geometry><cylinder radius="0.03" length="0.25"/></geometry>
      </collision>
    </link>

    <joint name="${side}_elbow_joint" type="revolute">
      <parent link="${side}_upper_arm_link"/>
      <child link="${side}_forearm_link"/>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <xacro:if value="${side == 'left'}">
        <limit lower="0.0" upper="2.3" effort="30.0" velocity="2.5"/>
      </xacro:if>
      <xacro:if value="${side == 'right'}">
        <limit lower="-2.3" upper="0.0" effort="30.0" velocity="2.5"/>
      </xacro:if>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <link name="${side}_forearm_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 -0.1" rpy="0 0 0"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.1" rpy="0 0 0"/>
        <geometry><cylinder radius="0.025" length="0.2"/></geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.1" rpy="0 0 0"/>
        <geometry><cylinder radius="0.025" length="0.2"/></geometry>
      </collision>
    </link>

    <joint name="${side}_wrist_pitch_joint" type="revolute">
      <parent link="${side}_forearm_link"/>
      <child link="${side}_wrist_pitch_link"/>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="3.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <link name="${side}_wrist_pitch_link">
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
      <visual>
        <geometry><sphere radius="0.01"/></geometry>
        <material name="white"/>
      </visual>
    </link>

    <joint name="${side}_wrist_roll_joint" type="revolute">
      <parent link="${side}_wrist_pitch_link"/>
      <child link="${side}_wrist_roll_link"/>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="3.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <link name="${side}_wrist_roll_link">
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
      <visual>
        <geometry><sphere radius="0.01"/></geometry>
        <material name="white"/>
      </visual>
    </link>

    <joint name="${side}_wrist_yaw_joint" type="revolute">
      <parent link="${side}_wrist_roll_link"/>
      <child link="${side}_hand_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="3.0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <link name="${side}_hand_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 -0.03" rpy="0 0 0"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.03" rpy="0 0 0"/>
        <geometry><box size="0.06 0.06 0.02"/></geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.03" rpy="0 0 0"/>
        <geometry><box size="0.06 0.06 0.02"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:arm_7dof side="left" reflect="1"/>
  <xacro:arm_7dof side="right" reflect="-1"/>

  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="torso_link"><material>Gazebo/White</material></gazebo>
  <gazebo reference="head_link"><material>Gazebo/Blue</material></gazebo>

  <gazebo reference="left_wheel_link"><material>Gazebo/Black</material><mu1>15.0</mu1><mu2>15.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="right_wheel_link"><material>Gazebo/Black</material><mu1>15.0</mu1><mu2>15.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="front_caster_link"><material>Gazebo/Grey</material><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  <gazebo reference="back_caster_link"><material>Gazebo/Grey</material><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>

  <gazebo reference="left_upper_arm_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="left_forearm_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="left_hand_link"><material>Gazebo/White</material></gazebo>
  <gazebo reference="right_upper_arm_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="right_forearm_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="right_hand_link"><material>Gazebo/White</material></gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_shoulder_pitch_joint</joint_name>
      <topic>/model/service_robot/joint/left_shoulder_pitch_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_shoulder_roll_joint</joint_name>
      <topic>/model/service_robot/joint/left_shoulder_roll_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_shoulder_yaw_joint</joint_name>
      <topic>/model/service_robot/joint/left_shoulder_yaw_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_elbow_joint</joint_name>
      <topic>/model/service_robot/joint/left_elbow_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_wrist_pitch_joint</joint_name>
      <topic>/model/service_robot/joint/left_wrist_pitch_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_wrist_roll_joint</joint_name>
      <topic>/model/service_robot/joint/left_wrist_roll_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_wrist_yaw_joint</joint_name>
      <topic>/model/service_robot/joint/left_wrist_yaw_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_shoulder_pitch_joint</joint_name>
      <topic>/model/service_robot/joint/right_shoulder_pitch_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_shoulder_roll_joint</joint_name>
      <topic>/model/service_robot/joint/right_shoulder_roll_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_shoulder_yaw_joint</joint_name>
      <topic>/model/service_robot/joint/right_shoulder_yaw_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_elbow_joint</joint_name>
      <topic>/model/service_robot/joint/right_elbow_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_wrist_pitch_joint</joint_name>
      <topic>/model/service_robot/joint/right_wrist_pitch_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_wrist_roll_joint</joint_name>
      <topic>/model/service_robot/joint/right_wrist_roll_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_wrist_yaw_joint</joint_name>
      <topic>/model/service_robot/joint/right_wrist_yaw_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain><d_gain>10.0</d_gain>
    </plugin>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.52</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
    </plugin>
  </gazebo>

</robot>
